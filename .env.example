# --- Google OAuth (host) ---
# Path to the OAuth client secret (Desktop app) JSON from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Optional: verify the authenticated account matches this exact email
#GMAIL_ACCOUNT=you@gmail.com
# --- Calendar ---
# Default calendar ID for calendar tools (default: primary)
DEFAULT_CALENDAR=primary
# --- HTTP MCP server ---
MCP_PORT=3333
# Optional bearer token clients must send: Authorization: Bearer <token>
#MCP_AUTH_TOKEN=change-me